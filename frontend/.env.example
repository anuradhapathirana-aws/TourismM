# Leave empty to use the local mock data in src/data/.
# With the Laravel backend running (cd backend && php artisan serve), point this at its API:
# VITE_API_URL=http://localhost:8000/api/v1
# Only modules listed in LIVE_MODULES (src/services/api.js) are fetched from the API.
VITE_API_URL=http://127.0.0.1:8000/api/v1
